; Infinity Hunter — Godot 4 project
; Offline pixel hunting RPG. See docs/PRD.md for the full design.

config_version=5

[application]

config/name="Infinity Hunter"
config/description="Offline pixel hunting RPG: hunt, level explosively, craft gear, capture a companion, push farther, reset, repeat."
run/main_scene="res://src/ui/launch/launch_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/ui/game_state.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
